# Copier en .env (jamais commité) puis remplir. En Docker Compose, ces valeurs viennent du .env racine.

# ============ Application Dari ============
ENVIRONMENT=dev
# SQLite pour un essai rapide ; PostgreSQL : postgresql://dari:<mdp>@localhost:5432/dari
DATABASE_URL=sqlite:///./dari.db
# "require" pour Supabase, "disable" pour un Postgres local
DATABASE_SSLMODE=disable
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
# json (exploitation) ou text (lecture en dev)
LOG_FORMAT=text
# console : les mails (liens de connexion) sont écrits dans les logs (DEV UNIQUEMENT) ; resend : envoi réel
EMAIL_BACKEND=console
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=Dari
RATE_LIMIT_STORAGE_URI=memory://
PASSWORD_BREACH_CHECK=false
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10
SEUIL_ADMISSION=10
COMPENSATION=true
# Mot de passe des comptes créés par python -m scripts.seed_demo
DEMO_PASSWORD=

# ============ Authentification (auth-kit, préfixe AUTH_) ============
# Au moins 32 caractères : python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
AUTH_APP_NAME=Dari
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
# false : connexion sans lien email (DEV UNIQUEMENT, pour Swagger)
AUTH_LOGIN_EMAIL_REQUIRED=false
AUTH_FRONTEND_VERIFY_URL=http://localhost:5173/verify-email
AUTH_FRONTEND_RESET_URL=http://localhost:5173/reset-password
# false seulement en dev HTTP
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
