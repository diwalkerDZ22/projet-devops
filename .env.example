# Configuration de Docker Compose. Copier en .env (jamais commité : voir .gitignore) puis remplir.
# Générer un secret : python -c "import secrets; print(secrets.token_hex(32))"

ENVIRONMENT=dev
HTTP_PORT=8080
# URL publique de l'application (liens des mails, CORS)
PUBLIC_URL=http://localhost:8080

POSTGRES_USER=dari
POSTGRES_DB=dari
POSTGRES_PASSWORD=
# Base externe (Supabase) : décommenter. Sinon le PostgreSQL de Docker Compose est utilisé.
# DATABASE_URL=postgresql://postgres.<projet>:<mdp>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# DATABASE_SSLMODE=require

# Au moins 32 caractères
AUTH_SECRET_KEY=
# true en production : connexion confirmée par un lien email (nécessite RESEND_API_KEY)
AUTH_LOGIN_EMAIL_REQUIRED=false
# true dès que l'application est servie en HTTPS
AUTH_COOKIE_SECURE=false

# console : les mails sont écrits dans les journaux du backend ; resend : envoi réel
EMAIL_BACKEND=console
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev

# Mot de passe des comptes de démonstration (profil "demo")
DEMO_PASSWORD=

# Supervision (profil "monitoring")
GRAFANA_ADMIN_PASSWORD=

# Sauvegardes (profil "backup")
BACKUP_KEEP_DAYS=14
